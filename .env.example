NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Safe to expose client-side - this is Paystack's public key, not the secret
# key below. Used to open the inline checkout popup on our own domain.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_or_live_key

# Server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_or_secret_key
PAYSTACK_SECRET_KEY=sk_test_or_live_key

# Optional overrides. Amounts are in cents.
PPL_PACK_PRICE_CENTS=69900
SUBJECT_PRICE_CENTS=8900

# Optional. Cloudflare Turnstile site key for the "not a robot" check on
# login and sign-up. Leave unset to turn the check off. Turn on CAPTCHA in
# Supabase (Auth > Attack Protection) with the matching secret key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
